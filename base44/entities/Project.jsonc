{
  "name": "Project",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title",
      "description": "Project title."
    },
    "studio_type": {
      "type": "string",
      "title": "Studio Type",
      "description": "The studio this project belongs to (studio id from the Studio Registry)."
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "draft",
        "in_progress",
        "completed",
        "archived"
      ],
      "default": "draft",
      "description": "Lifecycle status of the project."
    },
    "project_data": {
      "type": "object",
      "title": "Project Data",
      "description": "Flexible payload for studio-specific project content (prompts, assets, layers, etc.).",
      "additionalProperties": true
    }
  },
  "required": [
    "title"
  ]
}