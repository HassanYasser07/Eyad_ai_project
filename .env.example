# ---- Frontend (Vite) — public values only; they ship inside the JS bundle ----
# Optional: defaults in src/lib/supabase.js point at the production project.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Web Push public (VAPID) key — must match VAPID_PUBLIC_KEY below
VITE_VAPID_PUBLIC_KEY=

# ---- Supabase Edge Function secrets (NEVER put these in frontend code or VITE_*) ----
# Set with: supabase secrets set NAME=value   (SUPABASE_URL / SUPABASE_ANON_KEY /
# SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.)
# OPENAI_API_KEY=         # eyad-engine, eyad-voice, eyad-transcribe
# RECRAFT_API_KEY=        # eyad-engine (logo / SVG generation)
# VAPID_PUBLIC_KEY=       # eyad-engine (push notifications)
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# PUBLIC_APP_URL=https://eyad-ai.com   # used for the push-notification icon URL
